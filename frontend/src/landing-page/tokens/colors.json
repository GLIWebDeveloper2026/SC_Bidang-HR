{
  "font": {
    "family": "Poppins",
    "weights": [
      400,
      500,
      600,
      700
    ]
  },
  "radius": {
    "md": "6px",
    "lg": "10px"
  },
  "color": {
    "primary": {
      "base": "#606BDF",
      "hover": "#4A54B3",
      "bg": "#EDEDFB",
      "border": "#8B93E8"
    },
    "success": {
