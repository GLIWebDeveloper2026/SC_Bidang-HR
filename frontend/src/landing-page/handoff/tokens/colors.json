{
  "font": {
    "family": "Poppins",
    "weights": [
      400,
      500,
      600,
      700
    ]
  },
  "radius": {
    "md": "6px",
    "lg": "10px"
  },
  "color": {
    "primary": {
      "base": "#1890FF",
      "hover": "#096DD9",
      "bg": "#E6F7FF",
      "border": "#91D5FF"
    },
    "success": {
      "bg": "#F6FFED",
      "text": "#237804",
      "border": "#B7EB8F"
    },
    "warning": {
      "bg": "#FFFBE6",
      "text": "#D48806",
      "border": "#FFE58F"
    },
    "error": {
      "bg": "#FFF1F0",
      "text": "#CF1322",
      "border": "#FFA39E",
      "button": "#FF4D4F",
      "buttonHover": "#CF1322"
    },
    "text": {
      "primary": "#262626",
      "secondary": "#595959",
      "placeholder": "#8C8C8C"
    },
    "surface": {
      "page": "#FAFAFA",
      "card": "#FFFFFF"
    },
    "border": {
      "default": "#D9D9D9",
      "focus": "#1890FF",
      "tableHeaderBg": "#FAFAFA"
    }
